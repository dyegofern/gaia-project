{
  "name": "gaia-agent-web",
  "version": "1.0.0",
  "description": "Web monitoring interface for GAIA Agent evaluations",
  "type": "module",
  "main": "web/server.js",
  "scripts": {
    "start": "node web/server.js",
    "dev": "node --watch web/server.js",
    "share": "ngrok http ${PORT:-3100} --basic-auth \"${NGROK_USER:-gaia}:${NGROK_PASS:?set NGROK_PASS}\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.3",
    "sql.js": "^1.10.3",
    "cors": "^2.8.5"
  }
}
